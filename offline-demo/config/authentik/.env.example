# ==============================================================================
# CONFIGURATION ENVIRONNEMENT AUTHENTIK — MESSAGERIE SOUVERAINE BF
# Ne commiter aucun secret dans Git.
# ==============================================================================

# Mot de passe de la base PostgreSQL interne d'Authentik (générer 20+ car. aléatoires)
PG_PASS=CHANGE_ME_authentik_postgres_password_24_chars

# Clé secrète Authentik (minimum 50 caractères aléatoires)
# Commande : python3 -c "import secrets; print(secrets.token_urlsafe(64))"
AUTHENTIK_SECRET_KEY=CHANGE_ME_authentik_secret_key_64_chars

# Ports locaux liés sur 127.0.0.1
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443
