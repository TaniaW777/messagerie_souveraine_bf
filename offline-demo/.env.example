# ============================================================
# MESSAGERIE SOUVERAINE BF — Variables d'environnement
# ============================================================
# INSTRUCTIONS :
#   1. Copier ce fichier : cp .env.example .env
#   2. Remplacer TOUTES les valeurs CHANGE_ME par des valeurs
#      réelles et sécurisées.
#   3. Ne jamais committer le fichier .env sur Git.
# ============================================================

# ------------------------------------------------------------
# IDENTITÉ DU SERVEUR
# En local : messagerie.local (ajouter dans /etc/hosts)
# En production : votre nom de domaine réel
# ATTENTION : ne jamais changer server_name après initialisation
# ------------------------------------------------------------
SYNAPSE_SERVER_NAME=messagerie.local

# ------------------------------------------------------------
# BASE DE DONNÉES POSTGRESQL (Synapse)
# ------------------------------------------------------------
POSTGRES_USER=synapse
POSTGRES_PASSWORD=CHANGE_ME_mot_de_passe_postgresql_long_et_aleatoire
POSTGRES_DB=synapse

# ------------------------------------------------------------
# SECRETS SYNAPSE
# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# ATTENTION : ne jamais réutiliser la même valeur entre les champs
# ------------------------------------------------------------
SYNAPSE_REGISTRATION_SHARED_SECRET=CHANGE_ME_generer_un_secret_aleatoire_64_caracteres
SYNAPSE_MACAROON_SECRET_KEY=CHANGE_ME_generer_un_autre_secret_aleatoire_64_caracteres
SYNAPSE_FORM_SECRET=CHANGE_ME_generer_un_troisieme_secret_aleatoire_64_caracteres

# ------------------------------------------------------------
# INTÉGRATION AUTHENTIK / OIDC
# Valeurs à renseigner après configuration du fournisseur OIDC
# dans l'interface Authentik (cf. docs/installation.md)
# ------------------------------------------------------------
AUTHENTIK_OIDC_CLIENT_ID=CHANGE_ME_client_id_depuis_authentik
AUTHENTIK_OIDC_CLIENT_SECRET=CHANGE_ME_client_secret_depuis_authentik
AUTHENTIK_ISSUER_URL=https://auth.messagerie.local

# ------------------------------------------------------------
# ADRESSE D'ÉCOUTE DU PROXY
# 127.0.0.1 : accès local strict (recommandé pour la sécurité)
# 0.0.0.0   : accessible sur le réseau local (démonstration multi-postes)
# ------------------------------------------------------------
MSB_BIND_ADDRESS=127.0.0.1

# ------------------------------------------------------------
# PORTS EXPOSÉS (optionnel, modifier si conflit)
# ------------------------------------------------------------
SYNAPSE_PORT=8008
ELEMENT_PORT=8081

# ------------------------------------------------------------
# SENTINEL BF — Cybersécurité et détection des menaces
# ------------------------------------------------------------
# Connexion lecture seule à la base PostgreSQL d'Authentik
AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_PASS=CHANGE_ME_mot_de_passe_postgresql_authentik
AUTHENTIK_PG_DB=authentik
# Secret d'authentification du webhook Sentinel
SENTINEL_WEBHOOK_SECRET=CHANGE_ME_generer_un_secret_webhook_long_et_aleatoire
# Mot de passe du compte technique @sentinel_bf:messagerie.local
SENTINEL_MATRIX_PASSWORD=CHANGE_ME_mot_de_passe_compte_sentinel_bf
