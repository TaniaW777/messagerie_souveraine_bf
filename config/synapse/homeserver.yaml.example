server_name: "${SYNAPSE_SERVER_NAME:-messagerie.local}"
pid_file: /data/homeserver.pid
public_baseurl: "https://${SYNAPSE_SERVER_NAME:-messagerie.local}/"

# ---------------------------------------------------------------
# RÉSEAU & ÉCOUTEURS
# x_forwarded: true car msb-proxy (Nginx) gère la terminaison TLS
# et transmet les en-têtes X-Forwarded-For et X-Forwarded-Proto.
# ---------------------------------------------------------------
listeners:
  - port: 8008
    tls: false
    type: http
    x_forwarded: true
    bind_addresses: ['0.0.0.0']
    resources:
      - names: [client]
        compress: false

# ---------------------------------------------------------------
# SOUVERAINETÉ NATIONALE : DÉSACTIVATION STRICTE DE LA FÉDÉRATION
# La liste blanche vide refuse toute tentative de fédération
# entrante ou sortante (HTTP 403 Federation denied).
# ---------------------------------------------------------------
federation_domain_whitelist: []
federation_sender_instances: []

# ---------------------------------------------------------------
# POLITIQUE DE SÉCURITÉ DES SALONS & CHIFFREMENT E2EE OBLIGATOIRE
# encryption_enabled_by_default_for_room_type: "all" impose le
# chiffrement Megolm (m.room.encryption) pour tous les nouveaux salons.
# forget_rooms_on_leave: purge les salons de la liste active lors d'un départ/kick.
# ---------------------------------------------------------------
encryption_enabled_by_default_for_room_type: "all"
forget_rooms_on_leave: true

# ---------------------------------------------------------------
# BASE DE DONNÉES (PostgreSQL 16)
# Le mot de passe doit correspondre à POSTGRES_PASSWORD dans .env
# ---------------------------------------------------------------
database:
  name: psycopg2
  args:
    user: synapse
    password: CHANGE_ME_mot_de_passe_postgresql_long_et_aleatoire
    database: synapse
    host: db
    port: 5432
    cp_min: 5
    cp_max: 10

# ---------------------------------------------------------------
# CHEMINS & STOCKAGE
# ---------------------------------------------------------------
log_config: "/data/${SYNAPSE_SERVER_NAME:-messagerie.local}.log.config"
media_store_path: /data/media_store
signing_key_path: "/data/${SYNAPSE_SERVER_NAME:-messagerie.local}.signing.key"
max_upload_size: 50M

# ---------------------------------------------------------------
# SECRETS SYNAPSE
# Valeurs CHANGE_ME : à remplacer par des chaînes aléatoires
# de 64 caractères minimum générées avec python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# NE JAMAIS COMMITTER les vraies valeurs.
# ---------------------------------------------------------------
registration_shared_secret: "CHANGE_ME_generer_un_secret_aleatoire_64_caracteres"
macaroon_secret_key: "CHANGE_ME_generer_un_autre_secret_aleatoire_64_caracteres"
form_secret: "CHANGE_ME_generer_un_troisieme_secret_aleatoire_64_caracteres"

# ---------------------------------------------------------------
# INSCRIPTION & SÉCURITÉ DES ACCÈS
# Désactivée : seuls les agents enrôlés par l'administrateur
# ou via l'IdP Authentik peuvent obtenir une identité.
# ---------------------------------------------------------------
enable_registration: false
allow_guest_registration: false
report_stats: false

# ---------------------------------------------------------------
# LIMITATION DE DÉBIT (Rate-limiting anti-bruteforce)
# ---------------------------------------------------------------
rc_login:
  address:
    per_second: 10
    burst_count: 100
  account:
    per_second: 10
    burst_count: 100
  failed_attempts:
    per_second: 10
    burst_count: 100

# ---------------------------------------------------------------
# INTÉGRATION FOURNISSEUR D'IDENTITÉ OIDC (AUTHENTIK)
# Délégation d'authentification centralisée avec TOTP obligatoire.
# Le client_secret NE DOIT JAMAIS être commité dans Git.
# ---------------------------------------------------------------
oidc_providers:
  - idp_id: authentik
    idp_name: "Authentik"
    discover: true
    issuer: "https://auth.messagerie.local/application/o/synapse/"
    client_id: "CHANGE_ME_authentik_oidc_client_id"
    client_secret: "CHANGE_ME_authentik_oidc_client_secret"
    scopes: ["openid", "profile", "email"]
    user_mapping_provider:
      config:
        localpart_template: "{{ user.preferred_username }}"
        display_name_template: "{{ user.name }}"
    allow_existing_users: true
    backchannel_logout_enabled: true
